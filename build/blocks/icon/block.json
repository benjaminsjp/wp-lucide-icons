{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "wpicons/icon",
    "title": "WP Icons",
    "category": "media",
    "icon": "star-filled",
    "description": "Insert an icon from Lucide, Material Symbols, Phosphor, Simple Icons, Tabler, Heroicons, Ionicons or Octicons.",
    "keywords": ["icon", "lucide", "material", "phosphor", "tabler", "svg"],
    "textdomain": "wpicons",
    "attributes": {
        "library": {
            "type": "string",
            "default": "lucide"
        },
        "name": {
            "type": "string",
            "default": ""
        },
        "size": {
            "type": "number",
            "default": 24
        },
        "color": {
            "type": "string",
            "default": "currentColor"
        },
        "strokeWidth": {
            "type": "number",
            "default": 2
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "variant": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "align": true,
        "className": true,
        "html": false,
        "spacing": {
            "margin": true
        }
    },
    "editorScript": "file:./index.js"
}
